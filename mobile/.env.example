# Copy this file to mobile/.env.
# Replace the example IP with your computer's local network IP.
# Your phone and computer must be on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.25:4000/api

# To use the deployed API instead, replace the URL above with:
# EXPO_PUBLIC_API_URL=https://harmonyapp.us/api
# EXPO_PUBLIC_ values are included in the app; never put secrets here.
