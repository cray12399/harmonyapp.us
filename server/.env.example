# Copy this file to server/.env and fill in the values shared by the Lead.
PORT=4000

# MongoDB Atlas connection string targeting the harmony-dev database.
MONGO_URI=

# Set a long, randomly generated secret for signing JWTs.
JWT_SECRET=

# Leave blank for local development to print verification/reset codes.
# For deployed email delivery, set the Resend API key and verified sender.
RESEND_API_KEY=
EMAIL_FROM="Harmony <noreply@harmonyapp.us>"

# Accounts created by the seed script. Set these before running npm run seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
